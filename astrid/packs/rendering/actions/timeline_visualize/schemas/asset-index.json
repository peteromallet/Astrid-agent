{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/asset-index.json",
  "title": "Astrid timeline visualization asset index v1",
  "type": "object",
  "required": ["schema_version", "snapshots", "assets"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "snapshots": {"$ref": "_defs.json#/$defs/snapshot_set"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stable_id",
          "qualified_ref",
          "canonical_ref",
          "source_id",
          "source_version",
          "role",
          "integrity_state",
          "expected_sha256",
          "observed_sha256",
          "contained_path"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^AS(?:0[1-9]|[1-9][0-9]+)$"
          },
          "qualified_ref": {"$ref": "_defs.json#/$defs/asset_qualified_ref"},
          "canonical_ref": {
            "allOf": [
              {"$ref": "_defs.json#/$defs/canonical_ref"},
              {"properties": {"kind": {"const": "asset"}}}
            ]
          },
          "source_id": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "source_version": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "role": {"$ref": "_defs.json#/$defs/asset_role"},
          "media_type": {
            "description": "Frozen coarse media kind used when a verified managed-CAS locator has no filename suffix.",
            "type": ["string", "null"],
            "enum": ["image", "video", "audio", null]
          },
          "integrity_state": {"$ref": "_defs.json#/$defs/integrity_state"},
          "expected_sha256": {"$ref": "_defs.json#/$defs/nullable_raw_sha256"},
          "observed_sha256": {
            "description": "Raw SHA-256 observed during integrity verification; null is REQUIRED when integrity_state is hash_unrecorded.",
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "contained_path": {"$ref": "_defs.json#/$defs/nullable_contained_source_path"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"integrity_state": {"enum": ["verified_original", "hash_mismatch"]}},
              "required": ["integrity_state"]
            },
            "then": {
              "properties": {
                "expected_sha256": {"$ref": "_defs.json#/$defs/raw_sha256"},
                "observed_sha256": {"$ref": "_defs.json#/$defs/raw_sha256"},
                "contained_path": {"$ref": "_defs.json#/$defs/contained_source_path"}
              }
            }
          },
          {
            "if": {
              "properties": {"integrity_state": {"const": "hash_unrecorded"}},
              "required": ["integrity_state"]
            },
            "then": {
              "properties": {
                "expected_sha256": {"type": "null"},
                "observed_sha256": {"type": "null"},
                "contained_path": {"$ref": "_defs.json#/$defs/contained_source_path"}
              }
            }
          },
          {
            "if": {
              "properties": {"integrity_state": {"const": "missing"}},
              "required": ["integrity_state"]
            },
            "then": {"properties": {"observed_sha256": {"type": "null"}}}
          },
          {
            "if": {
              "properties": {"integrity_state": {"const": "remote"}},
              "required": ["integrity_state"]
            },
            "then": {
              "properties": {
                "observed_sha256": {"type": "null"},
                "contained_path": {"type": "null"}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "snapshots are byte-identical to manifest.json snapshots",
    "every asset qualified_ref resolves through ground-truth.json objects with kind=asset",
    "source_id and source_version preserve normalized registry provenance and are null only when absent at the frozen source",
    "stable_id is the suffix of qualified_ref",
    "verified_original expected_sha256 equals observed_sha256",
    "hash_mismatch expected_sha256 differs from observed_sha256",
    "contained_path resolves beneath the frozen project sources root"
  ]
}
