{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/metric-definitions.json",
  "title": "Astrid timeline visualization metric definitions v1",
  "description": "Versioned machine artifact defining every metric name ground-truth.json stores a value for: id, name, definition, formula/derivation (the duration.py/model.py function it mirrors), unit, and scope.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "compositor_version",
    "metrics"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "timeline_visualize_metric_definitions"},
    "compositor_version": {"type": "string", "minLength": 1},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "name", "definition", "formula", "derivation", "unit", "scope"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "formula": {"type": "string", "minLength": 1},
          "derivation": {"type": "string", "minLength": 1},
          "unit": {
            "type": "string",
            "enum": ["frames", "seconds", "frames_per_second"]
          },
          "scope": {
            "type": "string",
            "enum": ["per-timeline", "per-scope"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "metric ids are unique and referenceable from ground-truth values",
    "every metric carries a formula and the duration.py/model.py function it derives from",
    "unit and scope come from the closed enums so machines can compare across packs"
  ]
}
