{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/action-index.json",
  "title": "Astrid timeline visualization action index v1",
  "type": "object",
  "required": ["schema_version", "snapshots", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "snapshots": {"$ref": "_defs.json#/$defs/snapshot_set"},
    "entries": {
      "type": "object",
      "required": [],
      "minProperties": 1,
      "patternProperties": {
        "^TL(?:0[1-9]|[1-9][0-9]+)(?:\\.(?:SH|RG|CL|AS|TS|SP)(?:0[1-9]|[1-9][0-9]+))?$": {
          "type": "object",
          "required": ["canonical_ref", "relations", "actions"],
          "properties": {
            "canonical_ref": {"$ref": "_defs.json#/$defs/canonical_ref"},
            "relations": {
              "type": "object",
              "required": ["parent", "previous", "next", "children"],
              "properties": {
                "parent": {
                  "oneOf": [
                    {"$ref": "_defs.json#/$defs/qualified_ref"},
                    {"type": "null"}
                  ]
                },
                "previous": {
                  "oneOf": [
                    {"$ref": "_defs.json#/$defs/qualified_ref"},
                    {"type": "null"}
                  ]
                },
                "next": {
                  "oneOf": [
                    {"$ref": "_defs.json#/$defs/qualified_ref"},
                    {"type": "null"}
                  ]
                },
                "children": {
                  "type": "array",
                  "items": {"$ref": "_defs.json#/$defs/qualified_ref"},
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "actions": {
              "type": "object",
              "required": [],
              "patternProperties": {
                "^[a-z][a-z0-9_]*$": {
                  "type": "object",
                  "required": [
                    "kind",
                    "argv",
                    "focus",
                    "result_scope",
                    "available",
                    "unavailable_reason",
                    "reads"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "argv": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "not": {
                          "pattern": "^(?:SH|RG|CL|AS|TS|SP)(?:0[1-9]|[1-9][0-9]+)$"
                        }
                      },
                      "minItems": 1
                    },
                    "focus": {
                      "oneOf": [
                        {"$ref": "_defs.json#/$defs/focus_ref"},
                        {"type": "null"}
                      ]
                    },
                    "result_scope": {"$ref": "_defs.json#/$defs/scope/properties/kind"},
                    "available": {"type": "boolean"},
                    "unavailable_reason": {
                      "oneOf": [
                        {"type": "string", "minLength": 1},
                        {"type": "null"}
                      ]
                    },
                    "reads": {"type": "string", "enum": ["snapshot", "current"]}
                  },
                  "allOf": [
                    {
                      "if": {"properties": {"available": {"const": true}}, "required": ["available"]},
                      "then": {"properties": {"unavailable_reason": {"type": "null"}}},
                      "else": {"properties": {"unavailable_reason": {"type": "string", "minLength": 1}}}
                    },
                    {
                      "if": {
                        "properties": {"focus": {"not": {"type": "null"}}},
                        "required": ["focus"]
                      },
                      "then": {
                        "properties": {
                          "argv": {
                            "allOf": [
                              {"contains": {"const": "--from-view"}, "minContains": 1, "maxContains": 1},
                              {"contains": {"const": "--focus"}, "minContains": 1, "maxContains": 1}
                            ]
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "argv": {"not": {"contains": {"const": "--focus"}}}
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "snapshots are byte-identical to manifest.json snapshots",
    "every entries key and every non-null relation resolve through ground-truth.json objects",
    "each entry canonical_ref equals the authoritative ground-truth.json canonical_ref for its key",
    "parent/children and previous/next relations are reciprocal",
    "every visualize action that passes --focus also passes --from-view and uses a qualified focus ref",
    "reads=current is reserved for refresh_root actions"
  ]
}
