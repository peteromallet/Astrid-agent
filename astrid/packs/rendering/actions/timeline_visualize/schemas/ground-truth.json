{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/ground-truth.json",
  "title": "Astrid timeline visualization ground truth v1",
  "description": "Frozen semantic model. The operational frozen_at timestamp is never part of SNS content identity.",
  "type": "object",
  "required": [
    "schema_version",
    "snapshots",
    "project_slug",
    "scope",
    "objects",
    "timelines",
    "timestamps"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "snapshots": {"$ref": "_defs.json#/$defs/snapshot_set"},
    "project_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "scope": {"$ref": "_defs.json#/$defs/scope"},
    "objects": {
      "type": "array",
      "items": {"$ref": "_defs.json#/$defs/object_identity"},
      "minItems": 1,
      "uniqueItems": true
    },
    "timelines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["timeline_ref", "durations", "tracks", "clips", "assets"],
        "properties": {
          "timeline_ref": {"$ref": "_defs.json#/$defs/timeline_id"},
          "durations": {
            "type": "object",
            "required": [
              "authored_visual_only_end_seconds",
              "frame_quantized_visual_end",
              "all_track_composition",
              "authored_all_track_composition"
            ],
            "properties": {
              "authored_visual_only_end_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
              "frame_quantized_visual_end": {"$ref": "_defs.json#/$defs/frame_extent"},
              "all_track_composition": {"$ref": "_defs.json#/$defs/composition_extent"},
              "authored_all_track_composition": {"$ref": "_defs.json#/$defs/composition_extent"}
            },
            "additionalProperties": false
          },
          "tracks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["authored_id", "kind", "label", "muted", "config_order", "paint_order"],
              "properties": {
                "authored_id": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "enum": ["visual", "audio"]},
                "label": {"type": "string"},
                "muted": {"type": "boolean"},
                "config_order": {"type": "integer", "minimum": 0},
                "paint_order": {
                  "description": "Zero-based compositor paint ordinal for visual tracks; null for audio.",
                  "oneOf": [
                    {"type": "integer", "minimum": 0},
                    {"type": "null"}
                  ]
                }
              },
              "allOf": [
                {
                  "if": {"properties": {"kind": {"const": "visual"}}, "required": ["kind"]},
                  "then": {"properties": {"paint_order": {"type": "integer", "minimum": 0}}},
                  "else": {"properties": {"paint_order": {"type": "null"}}}
                }
              ],
              "additionalProperties": false
            }
          },
          "clips": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "stable_id",
                "qualified_ref",
                "canonical_ref",
                "track_authored_id",
                "clip_type",
                "at_seconds",
                "start_frame",
                "end_frame",
                "source_bounds",
                "speed",
                "transition",
                "asset_refs"
              ],
              "properties": {
                "stable_id": {
                  "type": "string",
                  "pattern": "^CL(?:0[1-9]|[1-9][0-9]+)$"
                },
                "qualified_ref": {"$ref": "_defs.json#/$defs/clip_qualified_ref"},
                "canonical_ref": {
                  "allOf": [
                    {"$ref": "_defs.json#/$defs/canonical_ref"},
                    {"properties": {"kind": {"const": "clip"}}}
                  ]
                },
                "track_authored_id": {"type": "string", "minLength": 1},
                "clip_type": {"type": "string", "minLength": 1},
                "at_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
                "start_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
                "end_frame": {"type": "integer", "minimum": 1},
                "mounted_interval": {
                  "type": "object",
                  "required": ["start_frame", "end_frame", "start_seconds", "end_seconds"],
                  "properties": {
                    "start_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
                    "end_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
                    "start_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
                    "end_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"}
                  },
                  "additionalProperties": false
                },
                "source_bounds": {
                  "type": "object",
                  "required": ["from_seconds", "to_seconds", "hold_seconds", "duration_seconds"],
                  "properties": {
                    "from_seconds": {"$ref": "_defs.json#/$defs/nullable_nonnegative_seconds"},
                    "to_seconds": {"$ref": "_defs.json#/$defs/nullable_nonnegative_seconds"},
                    "hold_seconds": {"$ref": "_defs.json#/$defs/nullable_nonnegative_seconds"},
                    "duration_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"}
                  },
                  "additionalProperties": false
                },
                "speed": {"type": "number", "exclusiveMinimum": 0},
                "transition": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "id",
                        "state",
                        "ignored_reason",
                        "requested_duration_frames",
                        "requested_duration_seconds",
                        "resolution_source",
                        "resolved_duration_frames",
                        "effective_interval"
                      ],
                      "properties": {
                        "id": {"type": "string", "minLength": 1},
                        "state": {"type": "string", "enum": ["accepted", "ignored"]},
                        "ignored_reason": {
                          "oneOf": [
                            {"type": "string", "minLength": 1},
                            {"type": "null"}
                          ]
                        },
                        "requested_duration_frames": {
                          "oneOf": [
                            {"type": "integer"},
                            {"type": "null"}
                          ]
                        },
                        "requested_duration_seconds": {
                          "oneOf": [
                            {"type": "number"},
                            {"type": "null"}
                          ]
                        },
                        "resolution_source": {
                          "oneOf": [
                            {"$ref": "_defs.json#/$defs/transition_resolution_source"},
                            {"type": "null"}
                          ]
                        },
                        "resolved_duration_frames": {
                          "oneOf": [
                            {"type": "integer", "minimum": 1},
                            {"type": "null"}
                          ]
                        },
                        "effective_interval": {"$ref": "_defs.json#/$defs/nullable_frame_interval"}
                      },
                      "allOf": [
                        {
                          "if": {"properties": {"state": {"const": "accepted"}}, "required": ["state"]},
                          "then": {
                            "properties": {
                              "ignored_reason": {"type": "null"},
                              "resolution_source": {"$ref": "_defs.json#/$defs/transition_resolution_source"},
                              "resolved_duration_frames": {"type": "integer", "minimum": 1},
                              "effective_interval": {
                                "type": "object",
                                "required": ["start_frame", "end_frame", "start_seconds", "end_seconds"],
                                "properties": {
                                  "start_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
                                  "end_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
                                  "start_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
                                  "end_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"}
                                },
                                "additionalProperties": false
                              }
                            }
                          },
                          "else": {
                            "properties": {
                              "ignored_reason": {"type": "string", "minLength": 1},
                              "effective_interval": {"type": "null"}
                            }
                          }
                        }
                      ],
                      "additionalProperties": false
                    },
                    {"type": "null"}
                  ]
                },
                "asset_refs": {
                  "type": "array",
                  "items": {"$ref": "_defs.json#/$defs/asset_qualified_ref"},
                  "uniqueItems": true
                },
                "mapped_speech": {
                  "type": "array",
                  "items": {"$ref": "_defs.json#/$defs/speech_qualified_ref"},
                  "uniqueItems": true
                },
                "authored_text": {
                  "oneOf": [
                    {"type": "string"},
                    {"type": "null"}
                  ]
                },
                "pixel_text": {
                  "oneOf": [
                    {"type": "string", "const": "not_inspected"},
                    {"type": "null"}
                  ]
                },
                "emphasized": {
                  "description": "True when this clip is part of the scope's active-stack emphasis set (the focused object or the exact visual compositor stack at a timestamp instant); false for context clips. Absent on unscoped emissions.",
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "assets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "stable_id",
                "qualified_ref",
                "canonical_ref",
                "role",
                "integrity_state"
              ],
              "properties": {
                "stable_id": {
                  "type": "string",
                  "pattern": "^AS(?:0[1-9]|[1-9][0-9]+)$"
                },
                "qualified_ref": {"$ref": "_defs.json#/$defs/asset_qualified_ref"},
                "canonical_ref": {
                  "allOf": [
                    {"$ref": "_defs.json#/$defs/canonical_ref"},
                    {"properties": {"kind": {"const": "asset"}}}
                  ]
                },
                "role": {"$ref": "_defs.json#/$defs/asset_role"},
                "integrity_state": {"$ref": "_defs.json#/$defs/integrity_state"}
              },
              "additionalProperties": false
            }
          },
          "transcript_attachment": {
            "type": "object",
            "required": [
              "schema_version", "source_id", "source_version",
              "transcript_sha256", "media_identity", "media_sha256",
              "producer", "producer_version", "model", "integrity"
            ],
            "properties": {
              "schema_version": {"type": "integer", "const": 1},
              "source_id": {"type": "string", "minLength": 1},
              "source_version": {"type": "string", "minLength": 1},
              "transcript_sha256": {"$ref": "_defs.json#/$defs/raw_sha256"},
              "media_identity": {"type": "string", "minLength": 1},
              "media_sha256": {
                "oneOf": [
                  {"$ref": "_defs.json#/$defs/raw_sha256"},
                  {"type": "null"}
                ]
              },
              "producer": {"type": "string", "minLength": 1},
              "producer_version": {
                "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
              },
              "model": {
                "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
              },
              "integrity": {
                "type": "string",
                "enum": ["ok", "missing", "hash_mismatch", "unreadable"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "frozen_objects": {
      "description": "Complete root-lineage identity allocation copied byte-for-byte into descendants.",
      "type": "array",
      "items": {"$ref": "_defs.json#/$defs/object_identity"},
      "minItems": 1,
      "uniqueItems": true
    },
    "frozen_timeline": {
      "description": "Complete normalized timeline facts used for snapshot-only descendant scopes.",
      "$ref": "#/properties/timelines/items"
    },
    "frozen_shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stable_id", "qualified_ref", "canonical_ref", "member_clip_ids",
          "authored_interval", "frame_interval", "warnings"
        ],
        "properties": {
          "stable_id": {"type": "string", "pattern": "^SH(?:0[1-9]|[1-9][0-9]+)$"},
          "qualified_ref": {"$ref": "_defs.json#/$defs/shot_qualified_ref"},
          "canonical_ref": {
            "allOf": [
              {"$ref": "_defs.json#/$defs/canonical_ref"},
              {"properties": {"kind": {"const": "shot"}}}
            ]
          },
          "member_clip_ids": {
            "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
          },
          "authored_interval": {
            "oneOf": [
              {
                "type": "object",
                "required": ["start_seconds", "end_seconds"],
                "properties": {
                  "start_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
                  "end_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"}
                },
                "additionalProperties": false
              },
              {"type": "null"}
            ]
          },
          "frame_interval": {
            "oneOf": [
              {
                "type": "object",
                "required": ["start_frame", "end_frame"],
                "properties": {
                  "start_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
                  "end_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"}
                },
                "additionalProperties": false
              },
              {"type": "null"}
            ]
          },
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "frozen_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stable_id", "qualified_ref", "canonical_ref", "start_frame",
          "end_frame", "start_seconds", "end_seconds"
        ],
        "properties": {
          "stable_id": {"type": "string", "pattern": "^RG(?:0[1-9]|[1-9][0-9]+)$"},
          "qualified_ref": {"$ref": "_defs.json#/$defs/range_qualified_ref"},
          "canonical_ref": {
            "allOf": [
              {"$ref": "_defs.json#/$defs/canonical_ref"},
              {"properties": {"kind": {"const": "range"}}}
            ]
          },
          "start_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
          "end_frame": {"$ref": "_defs.json#/$defs/nonnegative_frame"},
          "start_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
          "end_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"}
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "timestamps": {
      "type": "object",
      "description": "Operational metadata only. frozen_at is excluded from every SNS preimage.",
      "required": ["frozen_at"],
      "properties": {
        "frozen_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "snapshots are ordered by timeline display ordinal and byte-identical across every artifact",
    "timelines contains exactly one model for every snapshots[].timeline.qualified_ref",
    "objects qualified_ref and canonical_ref triples are independently unique and authoritative",
    "stable_id is the suffix of qualified_ref and canonical_ref kind matches its prefix",
    "track authored_id and config_order values are unique within a timeline; visual paint_order is the reverse of visual config order",
    "clip canonical authored_id, qualified_ref, and stable_id values are unique within a timeline",
    "clip track_authored_id resolves to exactly one track in its timeline",
    "clip and asset references resolve through objects",
    "frame and second interval ends are not earlier than starts"
  ]
}
