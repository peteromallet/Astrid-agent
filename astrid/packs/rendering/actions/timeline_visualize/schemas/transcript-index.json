{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/transcript-index.json",
  "title": "Astrid timeline visualization transcript index v1",
  "description": "Empty arrays are valid in milestone one; milestone two populates the declared TS/SP records without changing v1 shape.",
  "type": "object",
  "required": ["schema_version", "snapshots", "sources", "speech_occurrences"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "snapshots": {"$ref": "_defs.json#/$defs/snapshot_set"},
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "stable_id",
          "qualified_ref",
          "canonical_ref",
          "asset_ref",
          "transcript_sha256",
          "source_segment_id",
          "source_interval",
          "speaker_state",
          "speaker",
          "text",
          "word_timing",
          "words"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^TS(?:0[1-9]|[1-9][0-9]+)$"
          },
          "qualified_ref": {"$ref": "_defs.json#/$defs/transcript_source_qualified_ref"},
          "canonical_ref": {
            "allOf": [
              {"$ref": "_defs.json#/$defs/canonical_ref"},
              {"properties": {"kind": {"const": "transcript_source_segment"}}}
            ]
          },
          "asset_ref": {"$ref": "_defs.json#/$defs/asset_qualified_ref"},
          "transcript_sha256": {"$ref": "_defs.json#/$defs/raw_sha256"},
          "source_segment_id": {"type": "string", "minLength": 1},
          "source_interval": {
            "type": "object",
            "required": ["start_seconds", "end_seconds"],
            "properties": {
              "start_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
              "end_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"}
            },
            "additionalProperties": false
          },
          "speaker_state": {"$ref": "_defs.json#/$defs/speaker_state"},
          "speaker": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "text": {"type": "string"},
          "word_timing": {"type": "string", "enum": ["available", "unavailable"]},
          "words": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "start_seconds", "end_seconds"],
                  "properties": {
                    "text": {"type": "string"},
                    "start_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"},
                    "end_seconds": {"$ref": "_defs.json#/$defs/nonnegative_seconds"}
                  },
                  "additionalProperties": false
                }
              },
              {"type": "null"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"speaker_state": {"const": "present"}}, "required": ["speaker_state"]},
            "then": {"properties": {"speaker": {"type": "string", "minLength": 1}}},
            "else": {"properties": {"speaker": {"type": "null"}}}
          },
          {
            "if": {"properties": {"word_timing": {"const": "available"}}, "required": ["word_timing"]},
            "then": {"properties": {"words": {"type": "array"}}},
            "else": {"properties": {"words": {"type": "null"}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "speech_occurrences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "stable_id",
          "qualified_ref",
          "canonical_ref",
          "source_ref",
          "clip_ref",
          "asset_ref",
          "authored_mapping",
          "effective_mapping",
          "speaker_state",
          "speaker",
          "text"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^SP(?:0[1-9]|[1-9][0-9]+)$"
          },
          "qualified_ref": {"$ref": "_defs.json#/$defs/speech_qualified_ref"},
          "canonical_ref": {
            "allOf": [
              {"$ref": "_defs.json#/$defs/canonical_ref"},
              {"properties": {"kind": {"const": "speech_occurrence"}}}
            ]
          },
          "source_ref": {"$ref": "_defs.json#/$defs/transcript_source_qualified_ref"},
          "clip_ref": {"$ref": "_defs.json#/$defs/clip_qualified_ref"},
          "asset_ref": {"$ref": "_defs.json#/$defs/asset_qualified_ref"},
          "authored_mapping": {"$ref": "_defs.json#/$defs/speech_mapping"},
          "effective_mapping": {"$ref": "_defs.json#/$defs/speech_mapping"},
          "speaker_state": {"$ref": "_defs.json#/$defs/speaker_state"},
          "speaker": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "text": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"speaker_state": {"const": "present"}}, "required": ["speaker_state"]},
            "then": {"properties": {"speaker": {"type": "string", "minLength": 1}}},
            "else": {"properties": {"speaker": {"type": "null"}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "snapshots are byte-identical to manifest.json snapshots",
    "all TS and SP qualified refs resolve through ground-truth.json objects",
    "SP source_ref resolves to exactly one sources entry",
    "SP clip_ref and asset_ref resolve through ground-truth.json with matching kinds",
    "authored_mapping preserves source-to-timeline arithmetic before compositor transition effects",
    "effective_mapping separately records compositor-retimed or clipped presentation",
    "interval ends are not earlier than starts"
  ]
}
