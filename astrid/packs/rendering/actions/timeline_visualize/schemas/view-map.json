{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/view-map.json",
  "title": "Astrid timeline visualization view map v1",
  "type": "object",
  "required": ["schema_version", "snapshots", "pages", "reading_order"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "snapshots": {"$ref": "_defs.json#/$defs/snapshot_set"},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "dimensions",
          "layout",
          "scope",
          "time_bounds",
          "object_boxes",
          "labels",
          "continuation_links",
          "reading_order"
        ],
        "properties": {
          "page_id": {"$ref": "_defs.json#/$defs/page_id"},
          "dimensions": {
            "type": "object",
            "required": ["width_px", "height_px"],
            "properties": {
              "width_px": {"type": "integer", "minimum": 1},
              "height_px": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "layout": {"$ref": "_defs.json#/$defs/layout_kind"},
          "scope": {"$ref": "_defs.json#/$defs/scope"},
          "time_bounds": {
            "type": "object",
            "required": ["start_frame", "end_frame", "start_seconds", "end_seconds"],
            "properties": {
              "start_frame": {"$ref": "_defs.json#/$defs/nullable_nonnegative_frame"},
              "end_frame": {"$ref": "_defs.json#/$defs/nullable_nonnegative_frame"},
              "start_seconds": {"$ref": "_defs.json#/$defs/nullable_nonnegative_seconds"},
              "end_seconds": {"$ref": "_defs.json#/$defs/nullable_nonnegative_seconds"}
            },
            "additionalProperties": false
          },
          "object_boxes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stable_id", "object_ref", "bbox", "lane", "z_order"],
              "properties": {
                "stable_id": {"$ref": "_defs.json#/$defs/stable_id"},
                "object_ref": {"$ref": "_defs.json#/$defs/qualified_ref"},
                "bbox": {"$ref": "_defs.json#/$defs/bbox"},
                "lane": {"type": "string", "minLength": 1},
                "z_order": {"type": "integer"}
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["object_ref", "text", "status", "reason", "bbox"],
              "properties": {
                "object_ref": {"$ref": "_defs.json#/$defs/qualified_ref"},
                "text": {"type": "string"},
                "status": {"type": "string", "enum": ["printed", "omitted"]},
                "reason": {
                  "oneOf": [
                    {"type": "string", "minLength": 1},
                    {"type": "null"}
                  ]
                },
                "bbox": {
                  "oneOf": [
                    {"$ref": "_defs.json#/$defs/bbox"},
                    {"type": "null"}
                  ]
                }
              },
              "allOf": [
                {
                  "if": {"properties": {"status": {"const": "printed"}}, "required": ["status"]},
                  "then": {
                    "properties": {
                      "reason": {"type": "null"},
                      "bbox": {"$ref": "_defs.json#/$defs/bbox"}
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {"type": "string", "minLength": 1},
                      "bbox": {"type": "null"}
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "continuation_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["object_ref", "target_page_id", "direction"],
              "properties": {
                "object_ref": {"$ref": "_defs.json#/$defs/qualified_ref"},
                "target_page_id": {"$ref": "_defs.json#/$defs/page_id"},
                "direction": {"type": "string", "enum": ["previous", "next"]}
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "reading_order": {
            "type": "array",
            "items": {"$ref": "_defs.json#/$defs/qualified_ref"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "reading_order": {
      "type": "array",
      "items": {"$ref": "_defs.json#/$defs/page_id"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "snapshots are byte-identical to manifest.json snapshots",
    "reading_order contains every pages[].page_id exactly once and no other page id",
    "each page reading_order contains only object refs present on that page",
    "all object and label refs resolve through ground-truth.json objects and each object-box stable_id is the ref suffix",
    "continuation target pages exist and links are reciprocal"
  ]
}
