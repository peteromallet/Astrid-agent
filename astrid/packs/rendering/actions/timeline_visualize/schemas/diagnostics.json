{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/diagnostics.json",
  "title": "Astrid timeline visualization diagnostics v1",
  "type": "object",
  "required": ["schema_version", "snapshots", "diagnostics"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "snapshots": {"$ref": "_defs.json#/$defs/snapshot_set"},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message", "object_ref"],
        "properties": {
          "severity": {"type": "string", "enum": ["warning", "error"]},
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "message": {"type": "string", "minLength": 1},
          "object_ref": {
            "oneOf": [
              {"$ref": "_defs.json#/$defs/qualified_ref"},
              {"type": "null"}
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "snapshots are byte-identical to manifest.json snapshots",
    "every non-null object_ref resolves through ground-truth.json objects"
  ]
}
