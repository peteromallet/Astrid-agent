{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/_defs.json",
  "title": "Astrid timeline visualization shared definitions",
  "$defs": {
    "positive_ordinal": {
      "type": "string",
      "pattern": "^(?:0[1-9]|[1-9][0-9]+)$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^(?:TL|SH|RG|CL|AS|TS|SP)(?:0[1-9]|[1-9][0-9]+)$"
    },
    "timeline_id": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)$"
    },
    "object_stable_id": {
      "type": "string",
      "pattern": "^(?:SH|RG|CL|AS|TS|SP)(?:0[1-9]|[1-9][0-9]+)$"
    },
    "qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)(?:\\.(?:SH|RG|CL|AS|TS|SP)(?:0[1-9]|[1-9][0-9]+))?$"
    },
    "non_timeline_qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)\\.(?:SH|RG|CL|AS|TS|SP)(?:0[1-9]|[1-9][0-9]+)$"
    },
    "clip_qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)\\.CL(?:0[1-9]|[1-9][0-9]+)$"
    },
    "shot_qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)\\.SH(?:0[1-9]|[1-9][0-9]+)$"
    },
    "range_qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)\\.RG(?:0[1-9]|[1-9][0-9]+)$"
    },
    "asset_qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)\\.AS(?:0[1-9]|[1-9][0-9]+)$"
    },
    "transcript_source_qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)\\.TS(?:0[1-9]|[1-9][0-9]+)$"
    },
    "speech_qualified_ref": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)\\.SP(?:0[1-9]|[1-9][0-9]+)$"
    },
    "timestamp_locator": {
      "type": "string",
      "pattern": "^TL(?:0[1-9]|[1-9][0-9]+)@(?:[0-9]{2,}:)?[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{3})?$"
    },
    "focus_ref": {
      "oneOf": [
        {"$ref": "#/$defs/qualified_ref"},
        {"$ref": "#/$defs/timestamp_locator"}
      ]
    },
    "page_id": {
      "type": "string",
      "pattern": "^PG(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})$"
    },
    "layout_kind": {
      "type": "string",
      "enum": [
        "project-index",
        "overview",
        "time-scaled",
        "linear",
        "filmstrip",
        "active-stack",
        "text-map",
        "source-card"
      ]
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Frozen timeline-visualize v1 ULID spelling. Uppercase is retained for immutable evidence-pack compatibility; public kernel timeline DTOs use the equivalent lowercase spelling."
    },
    "kernel_ulid": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Canonical user-facing v10 kernel ULID spelling (lowercase Crockford base32)."
    },
    "uuid": {
      "type": "string",
      "minLength": 1,
      "description": "Exact Runtime timeline_id; UUID values remain supported for compatibility."
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_raw_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/raw_sha256"},
        {"type": "null"}
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sns_digest": {
      "type": "string",
      "pattern": "^SNS:[0-9a-f]{64}$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "nullable_artifact_path": {
      "oneOf": [
        {"$ref": "#/$defs/artifact_path"},
        {"type": "null"}
      ]
    },
    "contained_source_path": {
      "description": "Absolute or project-relative local source path after containment verification.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "nullable_contained_source_path": {
      "oneOf": [
        {"$ref": "#/$defs/contained_source_path"},
        {"type": "null"}
      ]
    },
    "nonnegative_seconds": {
      "type": "number",
      "minimum": 0
    },
    "nullable_nonnegative_seconds": {
      "oneOf": [
        {"$ref": "#/$defs/nonnegative_seconds"},
        {"type": "null"}
      ]
    },
    "nonnegative_frame": {
      "type": "integer",
      "minimum": 0
    },
    "nullable_nonnegative_frame": {
      "oneOf": [
        {"$ref": "#/$defs/nonnegative_frame"},
        {"type": "null"}
      ]
    },
    "asset_role": {
      "type": "string",
      "enum": [
        "timeline_media",
        "generation_reference",
        "generation_output",
        "thumbnail_only",
        "rendered_sample"
      ]
    },
    "integrity_state": {
      "type": "string",
      "enum": [
        "verified_original",
        "missing",
        "hash_mismatch",
        "hash_unrecorded",
        "remote",
        "thumbnail_only",
        "unsupported"
      ]
    },
    "canonical_ref": {
      "type": "object",
      "required": ["timeline_uuid", "kind", "authored_id"],
      "properties": {
        "timeline_uuid": {"$ref": "#/$defs/uuid"},
        "kind": {
          "type": "string",
          "enum": [
            "timeline",
            "shot",
            "range",
            "clip",
            "asset",
            "transcript_source_segment",
            "speech_occurrence"
          ]
        },
        "authored_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "object_identity": {
      "type": "object",
      "required": ["stable_id", "qualified_ref", "canonical_ref"],
      "properties": {
        "stable_id": {"$ref": "#/$defs/stable_id"},
        "qualified_ref": {"$ref": "#/$defs/qualified_ref"},
        "canonical_ref": {"$ref": "#/$defs/canonical_ref"}
      },
      "additionalProperties": false
    },
    "timeline_identity": {
      "type": "object",
      "required": ["stable_id", "qualified_ref", "uuid", "ulid", "slug"],
      "properties": {
        "stable_id": {"$ref": "#/$defs/timeline_id"},
        "qualified_ref": {"$ref": "#/$defs/timeline_id"},
        "uuid": {"$ref": "#/$defs/uuid"},
        "ulid": {"$ref": "#/$defs/ulid"},
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "canonical_timeline_identity": {
      "description": "Comparison-safe user-facing projection of a frozen timeline identity. The exact Runtime timeline ID and slug are unchanged; ULID uses the lowercase kernel spelling.",
      "type": "object",
      "required": ["stable_id", "qualified_ref", "uuid", "ulid", "slug"],
      "properties": {
        "stable_id": {"$ref": "#/$defs/timeline_id"},
        "qualified_ref": {"$ref": "#/$defs/timeline_id"},
        "uuid": {"$ref": "#/$defs/uuid"},
        "ulid": {"$ref": "#/$defs/kernel_ulid"},
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "event_head": {
      "type": "object",
      "required": ["version", "last_event_id", "last_hash"],
      "properties": {
        "version": {"type": "integer", "minimum": 0},
        "last_event_id": {
          "oneOf": [
            {"$ref": "#/$defs/ulid"},
            {"type": "null"}
          ]
        },
        "last_hash": {"$ref": "#/$defs/nullable_raw_sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"version": {"const": 0}}, "required": ["version"]},
          "then": {
            "properties": {
              "last_event_id": {"type": "null"},
              "last_hash": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "last_event_id": {"$ref": "#/$defs/ulid"},
              "last_hash": {"$ref": "#/$defs/raw_sha256"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "timeline_snapshot": {
      "type": "object",
      "required": ["timeline", "digest", "event_head", "fps"],
      "properties": {
        "timeline": {"$ref": "#/$defs/timeline_identity"},
        "digest": {"$ref": "#/$defs/sns_digest"},
        "event_head": {"$ref": "#/$defs/event_head"},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "snapshot_set": {
      "type": "array",
      "items": {"$ref": "#/$defs/timeline_snapshot"},
      "minItems": 1,
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "required": ["kind", "ref", "start_frame", "end_frame", "start_seconds", "end_seconds"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "project",
            "timeline",
            "shot",
            "range",
            "clip",
            "asset",
            "timestamp",
            "text",
            "speech"
          ]
        },
        "ref": {
          "oneOf": [
            {"$ref": "#/$defs/focus_ref"},
            {"type": "null"}
          ]
        },
        "start_frame": {"$ref": "#/$defs/nullable_nonnegative_frame"},
        "end_frame": {"$ref": "#/$defs/nullable_nonnegative_frame"},
        "start_seconds": {"$ref": "#/$defs/nullable_nonnegative_seconds"},
        "end_seconds": {"$ref": "#/$defs/nullable_nonnegative_seconds"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "project"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "timeline"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/timeline_id"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "shot"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/shot_qualified_ref"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "range"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/range_qualified_ref"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "clip"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/clip_qualified_ref"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "asset"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/asset_qualified_ref"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "timestamp"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/timestamp_locator"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "text"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/transcript_source_qualified_ref"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "speech"}}, "required": ["kind"]},
          "then": {"properties": {"ref": {"$ref": "#/$defs/speech_qualified_ref"}}}
        }
      ],
      "additionalProperties": false
    },
    "frame_extent": {
      "type": "object",
      "required": ["frames", "seconds"],
      "properties": {
        "frames": {"$ref": "#/$defs/nonnegative_frame"},
        "seconds": {"$ref": "#/$defs/nonnegative_seconds"}
      },
      "additionalProperties": false
    },
    "composition_extent": {
      "type": "object",
      "description": "Compositor duration has a one-frame floor, including an empty timeline.",
      "required": ["frames", "seconds"],
      "properties": {
        "frames": {"type": "integer", "minimum": 1},
        "seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "nullable_frame_interval": {
      "oneOf": [
        {
          "type": "object",
          "required": ["start_frame", "end_frame", "start_seconds", "end_seconds"],
          "properties": {
            "start_frame": {"$ref": "#/$defs/nonnegative_frame"},
            "end_frame": {"$ref": "#/$defs/nonnegative_frame"},
            "start_seconds": {"$ref": "#/$defs/nonnegative_seconds"},
            "end_seconds": {"$ref": "#/$defs/nonnegative_seconds"}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "transition_resolution_source": {
      "type": "string",
      "enum": ["explicit_frames", "explicit_seconds", "registry_default", "hard_fallback"]
    },
    "speaker_state": {
      "type": "string",
      "enum": ["present", "absent", "legacy_unavailable"]
    },
    "speech_mapping": {
      "type": "object",
      "required": ["state", "interval"],
      "properties": {
        "state": {"type": "string", "enum": ["exact", "clipped", "retimed", "unavailable"]},
        "interval": {"$ref": "#/$defs/nullable_frame_interval"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "unavailable"}}, "required": ["state"]},
          "then": {"properties": {"interval": {"type": "null"}}},
          "else": {
            "properties": {
              "interval": {
                "type": "object",
                "required": ["start_frame", "end_frame", "start_seconds", "end_seconds"],
                "properties": {
                  "start_frame": {"$ref": "#/$defs/nonnegative_frame"},
                  "end_frame": {"$ref": "#/$defs/nonnegative_frame"},
                  "start_seconds": {"$ref": "#/$defs/nonnegative_seconds"},
                  "end_seconds": {"$ref": "#/$defs/nonnegative_seconds"}
                },
                "additionalProperties": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["available", "unavailable_reason"],
      "properties": {
        "available": {"type": "boolean"},
        "unavailable_reason": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"available": {"const": true}}, "required": ["available"]},
          "then": {"properties": {"unavailable_reason": {"type": "null"}}},
          "else": {"properties": {"unavailable_reason": {"type": "string", "minLength": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "optional_entrypoint": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": {"$ref": "#/$defs/nullable_artifact_path"},
        "reason": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "path": {"$ref": "#/$defs/artifact_path"},
            "reason": {"type": "null"}
          }
        },
        {
          "properties": {
            "path": {"type": "null"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ],
      "additionalProperties": false
    },
    "universal_output": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/artifact_path"},
        "type": {"type": "string", "enum": ["file", "directory"]},
        "content_hash": {"$ref": "#/$defs/content_hash"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/raw_sha256"},
        "optional": {"type": "boolean"},
        "missing": {"type": "boolean"},
        "label": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "artifact_type": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "bytes", "content_hash"],
            "properties": {
              "path": {"$ref": "#/$defs/artifact_path"},
              "bytes": {"type": "integer", "minimum": 0},
              "content_hash": {"$ref": "#/$defs/content_hash"}
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"missing": {"const": true}},
            "required": ["missing"]
          },
          "then": {
            "properties": {"optional": {"const": true}},
            "required": ["optional"]
          },
          "else": {"required": ["type", "content_hash", "bytes"]}
        }
      ],
      "additionalProperties": false
    }
  }
}
