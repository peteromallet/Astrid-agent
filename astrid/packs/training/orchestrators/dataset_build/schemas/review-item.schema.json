{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrid.builtin-training/schemas/review-item.schema.json",
  "title": "ReviewItem",
  "description": "A candidate item with full metadata, served to the human review UI. Extends CandidateItem with caption, filter results, and paired-media placeholders.",
  "type": "object",
  "required": [
    "item_id",
    "source_type",
    "source_id",
    "source_url",
    "content_hash",
    "acquired_at",
    "media_type",
    "media_path"
  ],
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "type": "string",
      "description": "Unique identifier for this review item. Typically '{video_id}-s{scene_index:02d}'."
    },
    "source_type": {
      "type": "string",
      "enum": ["youtube", "local_folder", "stock_api", "generated", "image", "audio", "paired"]
    },
    "source_id": {
      "type": "string",
      "description": "Stable external identifier for the source."
    },
    "source_url": {
      "type": "string",
      "description": "URL or file:// URI."
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": {"type": "string"},
        "attribution": {"type": "string"},
        "restrictions": {"type": "array", "items": {"type": "string"}},
        "rights_status": {"type": "string", "enum": ["verified", "unknown", "needs_review", "restricted"]}
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "downloaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string"},
        "source_type": {"type": "string"},
        "transformation": {"type": "string"}
      }
    },
    "media_path": {
      "type": "string",
      "description": "Local filesystem path to the media file."
    },
    "media_type": {
      "type": "string",
      "enum": ["video", "image", "audio", "paired"],
      "description": "Concrete media type."
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "clip_start_s": {
      "type": "number",
      "minimum": 0
    },
    "clip_end_s": {
      "type": "number",
      "minimum": 0
    },
    "scene_index": {
      "type": "integer",
      "minimum": 0
    },
    "bucket": {
      "type": "string",
      "description": "Bucket this item is assigned to."
    },
    "caption": {
      "type": "object",
      "description": "Caption produced by the caption provider.",
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "description": "The caption string."},
        "schema_version": {"type": "integer"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "model": {"type": "string"},
        "raw_response": {"type": "object", "additionalProperties": true}
      }
    },
    "caption_file": {
      "type": "string",
      "description": "Path to the caption sidecar JSON file."
    },
    "caption_validation": {
      "type": "object",
      "description": "Validation metadata for the accepted caption sidecar and final caption text.",
      "additionalProperties": false,
      "required": ["valid", "failures"],
      "properties": {
        "valid": {"type": "boolean"},
        "schema_path": {"type": "string"},
        "validated_at": {"type": "string", "format": "date-time"},
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "additionalProperties": false,
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "path": {"type": "string"}
            }
          }
        }
      }
    },
    "filter_results": {
      "type": "object",
      "description": "Results from filter stages applied to this item.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "passed": {"type": "boolean"},
          "reason": {"type": "string"},
          "score": {"type": "number"}
        }
      }
    },
    "judge_result": {
      "type": "object",
      "description": "Raw judge/semantic-filter output for this item.",
      "additionalProperties": true
    },
    "pair_id": {
      "type": "string",
      "description": "Placeholder for future paired-media workflows. Identifies a related pair."
    },
    "pair_role": {
      "type": "string",
      "enum": ["target", "reference", "distractor"],
      "description": "Placeholder for future paired-media workflows. Role within a pair."
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "accepted", "rejected"],
      "default": "pending",
      "description": "Current review status."
    },
    "review_sampled": {
      "type": "object",
      "description": "Deterministic review sampling metadata. Unsampled items remain present and pending unless explicitly reviewed.",
      "additionalProperties": false,
      "required": ["sampled", "mode", "sample_count"],
      "properties": {
        "sampled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["all", "random_sample", "top_n"]},
        "sample_count": {"type": "integer", "minimum": 0},
        "rank": {"type": "integer", "minimum": 1}
      }
    },
    "review_decision": {
      "$ref": "review-decision.schema.json",
      "description": "The review decision for this item, if decided."
    }
  }
}
