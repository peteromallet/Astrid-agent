{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrid.builtin-training/schemas/dataset-config.schema.json",
  "title": "Dataset Config",
  "description": "Strict schema for newly generated training.dataset_build configs. schema_version: 1, media_type: video required.",
  "type": "object",
  "required": ["schema_version", "media_type"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Config schema version. Must be 1 for newly generated configs.",
      "const": 1
    },
    "media_type": {
      "type": "string",
      "description": "Media type for this dataset. Only 'video' is implemented in this epic.",
      "const": "video"
    },
    "dataset_id": {
      "type": "string",
      "description": "Stable identifier for this dataset. Auto-generated if absent."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the dataset."
    },
    "sources": {
      "type": "array",
      "description": "Source provider blocks. At least one required.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider"],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "description": "Source provider id. First concrete: 'youtube'.",
            "enum": ["youtube", "local_folder", "stock_api", "generated", "image", "audio", "paired"]
          },
          "config": {
            "type": "object",
            "description": "Provider-specific configuration."
          }
        }
      }
    },
    "buckets": {
      "type": "object",
      "description": "Bucket definitions. Keyed by bucket name.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["target_count"],
        "additionalProperties": false,
        "properties": {
          "target_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Target number of accepted clips for this bucket."
          },
          "description": {
            "type": "string",
            "description": "Human description of what this bucket represents."
          },
          "search_queries": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Search queries for source acquisition. Provider-specific."
          }
        }
      }
    },
    "clip_config": {
      "type": "object",
      "description": "Clip extraction and filtering parameters.",
      "additionalProperties": false,
      "properties": {
        "min_duration_s": {
          "type": "number",
          "minimum": 0,
          "default": 2.0,
          "description": "Minimum clip duration in seconds."
        },
        "max_duration_s": {
          "type": "number",
          "minimum": 0,
          "default": 60.0,
          "description": "Maximum clip duration in seconds."
        },
        "max_scenes_per_source": {
          "type": "integer",
          "minimum": 0,
          "default": 20,
          "description": "Maximum scenes to extract per source video."
        }
      }
    },
    "caption": {
      "type": "object",
      "description": "Caption provider configuration.",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "Caption provider id.",
          "enum": ["visual_understand", "video_understand", "transcribe"]
        },
        "prompt_template": {
          "type": "string",
          "description": "Prompt template for the caption model."
        },
        "schema_path": {
          "type": "string",
          "description": "Path to JSON schema for structured caption output."
        },
        "validation": {
          "type": "object",
          "description": "Caption text validation rules applied before manifest export.",
          "additionalProperties": false,
          "properties": {
            "text_pattern": {
              "type": "string",
              "description": "Regular expression that final accepted caption text must match."
            },
            "required_prefix": {
              "type": "string",
              "description": "Required prefix for final accepted caption text."
            },
            "required_substrings": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Required substrings for final accepted caption text."
            },
            "min_length": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum accepted caption text length."
            },
            "max_length": {
              "type": "integer",
              "minimum": 0,
              "description": "Maximum accepted caption text length."
            }
          }
        }
      }
    },
    "filters": {
      "type": "object",
      "description": "Filter stage configuration.",
      "additionalProperties": false,
      "properties": {
        "stages": {
          "type": "array",
          "description": "Ordered filter stages. When present, stages execute in list order.",
          "items": {
            "type": "object",
            "required": ["stage_id"],
            "additionalProperties": false,
            "properties": {
              "stage_id": {
                "type": "string",
                "enum": [
                  "duration_filter",
                  "resolution_filter",
                  "rights_filter",
                  "black_frame_filter",
                  "content_hash_filter",
                  "source_cap_filter",
                  "bucket_judge_filter",
                  "transcript_keyword_filter",
                  "semantic_visual_filter",
                  "semantic_video_filter",
                  "near_duplicate_filter"
                ]
              },
              "enabled": {"type": "boolean", "default": true},
              "config": {
                "type": "object",
                "description": "Stage-specific configuration.",
                "additionalProperties": true
              },
              "model_backed": {
                "type": "boolean",
                "description": "Normalized runtime marker for model-backed stages."
              },
              "expensive": {
                "type": "boolean",
                "description": "Normalized runtime marker for stages that may spend API/model budget."
              }
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "min_s": {"type": "number", "default": 2.0},
            "max_s": {"type": "number", "default": 60.0},
            "min_duration_s": {"type": "number"},
            "max_duration_s": {"type": "number"}
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "min_width": {"type": "integer", "default": 480},
            "min_height": {"type": "integer", "default": 360},
            "require_metadata": {"type": "boolean", "default": false}
          }
        },
        "black_frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "max_black_frame_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.98},
            "probe_media": {"type": "boolean", "default": false}
          }
        },
        "content_hash": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true}
          }
        },
        "source_cap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "max_per_source": {"type": "integer", "minimum": 0}
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "reject_statuses": {
              "type": "array",
              "items": {"type": "string"}
            },
            "restricted_licenses": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "description": "Human review configuration.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["all", "random_sample", "top_n"],
              "default": "all"
            },
            "sample_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of items to sample if mode is not 'all'."
            }
          }
        },
        "reject_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["watermark", "wrong_scene", "wrong_character", "bad_motion", "low_quality", "wrong_content", "rights_concern", "other"]
          }
        },
        "top_up": {
          "type": "object",
          "description": "Post-review acquisition loop configuration for bucket shortfalls.",
          "additionalProperties": false,
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 0,
              "default": 2,
              "description": "Maximum post-review top-up rounds. Use 0 to disable top-up."
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "description": "Manifest adapter configuration.",
      "required": ["adapter"],
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "description": "Manifest adapter id.",
          "enum": ["ai-toolkit-ltx"]
        }
      }
    },
    "budgets": {
      "type": "object",
      "description": "API call and cost budgets.",
      "additionalProperties": false,
      "properties": {
        "max_api_calls": {
          "type": "integer",
          "minimum": 0,
          "default": 500
        },
        "max_estimated_cost_usd": {
          "type": "number",
          "minimum": 0,
          "default": 5.0
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "max_calls": {"type": "integer", "minimum": 0},
              "rate_limit_per_minute": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Output configuration.",
      "additionalProperties": false,
      "properties": {
        "run_dir": {
          "type": "string",
          "description": "Output directory for this run."
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Reserved extension object. Unknown keys here do not cause validation failure.",
      "additionalProperties": true
    }
  }
}
