{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrid.builtin-training/schemas/training-run-config.schema.json",
  "title": "Training Run Config",
  "description": "Configuration for training.training_run. Schema version 1, ai-toolkit-ltx trainer, RunPod compute backend.",
  "type": "object",
  "required": ["schema_version", "trainer_id", "manifest_path", "compute", "base_model", "lora_config", "output"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "trainer_id": {
      "type": "string",
      "enum": ["ai-toolkit-ltx"],
      "description": "Trainer adapter id."
    },
    "manifest_path": {
      "type": "string",
      "description": "Path to the canonical or ai-toolkit adapter manifest."
    },
    "vocabulary_path": {
      "type": "string",
      "description": "Path to vocabulary YAML for caption templates."
    },
    "compute": {
      "type": "object",
      "required": ["backend", "max_gpu_hours", "max_runpod_spend_usd"],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "const": "runpod"
        },
        "gpu_type": {
          "type": "string",
          "default": "NVIDIA RTX 6000 Ada Generation",
          "description": "GPU type to provision."
        },
        "container_disk_gb": {
          "type": "integer",
          "minimum": 10,
          "default": 200
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 43200,
          "description": "Maximum pod runtime in seconds (12h default)."
        },
        "max_gpu_hours": {
          "type": "number",
          "minimum": 0,
          "description": "Hard cap on GPU hours for this run."
        },
        "max_runpod_spend_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Hard cap on estimated RunPod spend for this run."
        },
        "require_spend_confirmation": {
          "type": "boolean",
          "default": true,
          "description": "Headless runs must pre-confirm spend via config or CLI state."
        },
        "storage_name": {
          "type": "string",
          "description": "RunPod network storage volume name."
        },
        "storage_required": {
          "type": "boolean",
          "default": false,
          "description": "When true, training config validation requires storage_name and the RunPod backend passes --require-storage so the executor verifies the volume exists before provisioning."
        },
        "name_prefix": {
          "type": "string",
          "description": "RunPod pod name prefix."
        },
        "datacenter_id": {
          "type": "string",
          "description": "Optional RunPod datacenter id."
        },
        "image": {
          "type": "string",
          "default": "ostris/aitoolkit:latest",
          "description": "Docker image for the training pod."
        },
        "ports": {
          "type": "string",
          "default": "8675/http,22/tcp",
          "description": "Port mapping string for RunPod."
        },
        "upload_mode": {
          "type": "string",
          "default": "sftp_walk",
          "description": "Remote staging upload mode passed to the RunPod remote execution backend."
        },
        "excludes": {
          "description": "Files or directories excluded while staging local inputs to the pod.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "ssh_key": {
          "type": "string",
          "description": "Optional SSH private key path used for artifact pulls."
        },
        "stage_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout for staging inputs on the remote backend."
        },
        "training_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout for the remote training command."
        },
        "review_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout for remote sample generation and review artifact pulls."
        }
      }
    },
    "secrets": {
      "type": "object",
      "description": "Secret requirements declared as environment variable names. Values are read from the process environment during live preflight and are never stored in config state.",
      "required": ["required_env"],
      "additionalProperties": false,
      "properties": {
        "required_env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "base_model": {
      "type": "string",
      "description": "Base model identifier for training.",
      "default": "Lightricks/LTX-2.3/ltx-2.3-22b-dev.safetensors"
    },
    "lora_config": {
      "type": "object",
      "description": "LoRA-specific hyperparameters.",
      "additionalProperties": false,
      "properties": {
        "lora_id": {
          "type": "string",
          "description": "Identifier for this LoRA (used in output paths)."
        },
        "trigger_word": {
          "type": "string",
          "description": "Training trigger word or phrase to inject into captions and prompts."
        },
        "prompt_text": {
          "type": "string",
          "description": "Generic prompt text used by review and sample generation."
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "default": 16
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        },
        "learning_rate": {
          "type": "number",
          "minimum": 0,
          "default": 0.0001
        },
        "seed": {
          "type": "integer",
          "default": 42
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Sample and training frame width."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Sample and training frame height."
        },
        "num_frames": {
          "type": "integer",
          "minimum": 1,
          "description": "Frames per training/sample clip."
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "description": "Frames per second for training/sample clips."
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Trainer batch size."
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1,
          "description": "Gradient accumulation steps."
        },
        "save_every": {
          "type": "integer",
          "minimum": 1,
          "description": "Checkpoint save interval in training steps."
        },
        "sample_every": {
          "type": "integer",
          "minimum": 1,
          "description": "Sample generation interval in training steps."
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "description": "Checkpoint review configuration.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "sample_prompts": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Prompts used to generate sample outputs at each checkpoint."
        },
        "review_labels": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Labels shown during checkpoint review."
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["run_dir"],
      "additionalProperties": false,
      "properties": {
        "run_dir": {
          "type": "string",
          "description": "Output directory for this training run."
        },
        "remote_root": {
          "type": "string",
          "description": "Remote workspace root used while staging training inputs."
        },
        "remote_output_dir": {
          "type": "string",
          "description": "Remote directory where ai-toolkit writes checkpoints and samples."
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Reserved extension object.",
      "additionalProperties": true
    }
  }
}
