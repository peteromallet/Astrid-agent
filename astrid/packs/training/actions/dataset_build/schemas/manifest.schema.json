{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrid.builtin-training/schemas/manifest.schema.json",
  "title": "Canonical Dataset Manifest",
  "description": "The generic accepted-item manifest produced by training.dataset_build after review. This is the canonical manifest; training adapters consume this and produce their own format.",
  "type": "object",
  "required": ["manifest_version", "dataset_id", "media_type", "created_at", "items"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema version."
    },
    "dataset_id": {
      "type": "string",
      "description": "Stable identifier for this dataset."
    },
    "media_type": {
      "type": "string",
      "const": "video",
      "description": "Media type. Only 'video' in this epic."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this manifest was generated."
    },
    "source_provider": {
      "type": "string",
      "description": "Source provider id used for acquisition."
    },
    "manifest_adapter": {
      "type": "string",
      "description": "Manifest adapter id used for export (e.g., 'ai-toolkit-ltx')."
    },
    "items": {
      "type": "array",
      "description": "Accepted review items.",
      "items": {
        "$ref": "review-item.schema.json"
      }
    },
    "stats": {
      "type": "object",
      "description": "Aggregate statistics for the dataset.",
      "additionalProperties": false,
      "properties": {
        "total_accepted": {"type": "integer", "minimum": 0},
        "total_rejected": {"type": "integer", "minimum": 0},
        "total_pending": {"type": "integer", "minimum": 0},
        "total_sources": {"type": "integer", "minimum": 0},
        "buckets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "accepted": {"type": "integer"},
              "target": {"type": "integer"},
              "shortfall": {"type": "integer"}
            }
          }
        },
        "filter_pass_rates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "stage_id": {"type": "string"},
              "pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "total_duration_s": {"type": "number", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
