{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrid.builtin-training/schemas/candidate-item.schema.json",
  "title": "CandidateItem",
  "description": "A candidate media item produced by a source provider, before review or filtering.",
  "type": "object",
  "required": [
    "source_type",
    "source_id",
    "source_url",
    "content_hash",
    "acquired_at"
  ],
  "additionalProperties": false,
  "properties": {
    "source_type": {
      "type": "string",
      "description": "Type of source this candidate was acquired from.",
      "enum": ["youtube", "local_folder", "stock_api", "generated", "image", "audio", "paired"]
    },
    "source_id": {
      "type": "string",
      "description": "Stable external identifier for the source (e.g., YouTube video ID, file path hash)."
    },
    "source_url": {
      "type": "string",
      "description": "URL or file:// URI of the source."
    },
    "source_metadata": {
      "type": "object",
      "description": "Metadata from the source provider.",
      "additionalProperties": true,
      "properties": {
        "title": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 0},
        "resolution": {
          "type": "object",
          "properties": {
            "width": {"type": "integer", "minimum": 0},
            "height": {"type": "integer", "minimum": 0}
          }
        },
        "fps": {"type": "number", "minimum": 0},
        "codec": {"type": "string"},
        "file_size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "rights": {
      "type": "object",
      "description": "Rights and attribution information.",
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "string",
          "description": "License identifier (SPDX or custom)."
        },
        "attribution": {
          "type": "string",
          "description": "Required attribution text."
        },
        "restrictions": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Usage restrictions (e.g., 'no_commercial', 'no_derivatives')."
        },
        "rights_status": {
          "type": "string",
          "enum": ["verified", "unknown", "needs_review", "restricted"],
          "description": "Assessment of rights clarity."
        }
      }
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 hash of the media file content (hex digest).",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this candidate was acquired."
    },
    "derived_from": {
      "type": "object",
      "description": "Derivation metadata when media is generated or transformed.",
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string"},
        "source_type": {"type": "string"},
        "transformation": {"type": "string", "description": "Description of the transformation applied."}
      }
    },
    "media_path": {
      "type": "string",
      "description": "Local filesystem path to the acquired media file."
    },
    "media_type": {
      "type": "string",
      "enum": ["video", "image", "audio", "paired"],
      "description": "Concrete media type of this candidate."
    },
    "duration_s": {
      "type": "number",
      "minimum": 0,
      "description": "Duration of the media in seconds."
    },
    "clip_start_s": {
      "type": "number",
      "minimum": 0,
      "description": "Start offset within the source media, in seconds."
    },
    "clip_end_s": {
      "type": "number",
      "minimum": 0,
      "description": "End offset within the source media, in seconds."
    },
    "scene_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of the scene within the source video."
    }
  }
}
